<!--
  AFTER DARK 0.1.0 — черта «Жажда новых впечатлений» (Trait_AfterDark_NewExperiences).

  СТАТУС: ЧЕРНОВИК. Структура ориентировочная и НЕ проверена в игре.
  Перед сборкой обязательно:
    1. Открыть файл в Sims 4 Studio и привести поля к актуальной схеме тюнинга.
    2. Зарезервировать уникальный instance ID (s="...") и заменить значение-заглушку.
    3. Создать строки интерфейса в tuning/strings/ и подставить их хеши.
    4. Проверить черту в игре: выдача при создании персонажа и назначением.

  Черта добровольная: выбирается при создании персонажа либо назначается сценарием.
  Черта НЕ добавляет штрафов к репутации и НЕ меняет интеллект/навыки.
-->
<I c="Trait" i="trait" m="traits.trait" n="Trait_AfterDark_NewExperiences" s="0x00AD0001A0000001">
  <!-- Заглушка: поле name заполняется строкой из tuning/strings/ -->
  <T n="trait_name">0x00000000</T>
  <T n="trait_description">0x00000000</T>
  <!-- Добровольный выбор при создании персонажа -->
  <T n="is_selectable_at_creation">True</T>
  <!-- Ограничение: только совершеннолетние персонажи (18+) -->
  <T n="min_age">YOUNG_ADULT_OR_OLDER_PLACEHOLDER</T>
  <!-- Не выдаётся автоматически детям и подросткам -->
  <T n="is_exclusive_to_adults">True</T>
  <L n="buffs_added">
    <!-- Заглушка: сюда будут добавлены баффы из tuning/buffs/ -->
  </L>
  <L n="interactions_added">
    <!-- Заглушка: взаимодействия флирта из tuning/interactions/flirt_interactions.xml -->
  </L>
</I>
